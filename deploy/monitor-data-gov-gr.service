# Installed on the production VM at /etc/systemd/system/monitor-data-gov-gr.service
# After copying changes here to the VM: sudo systemctl daemon-reload && sudo systemctl restart monitor-data-gov-gr
#
# --threads 32: sized to comfortably hold the /api/communications/stream SSE
# connections (bounded at 55s each, one per open dashboard tab with Comms
# access) without starving ordinary request handling -- see the docstring on
# _stream_poller_loop() in app.py for the full reasoning.
#
# --graceful-timeout 10: gunicorn's 30s default meant a restart had to wait
# out any worker still holding an open SSE connection, since those requests
# don't finish on their own. Safe to cut short here -- a dropped SSE
# connection just has the browser's EventSource reconnect instantly.
[Unit]
Description=Communication Dashboard
After=network.target

[Service]
User=localadmin
WorkingDirectory=/home/localadmin/monitor-data-gov-gr
# Without this, bare print() calls (used throughout app.py's background
# threads for logging -- [health-check], [mqa], [hvd-check], [comms-stream],
# etc.) sit in Python's default block-buffered stdout instead of reaching
# journalctl promptly, since stdout isn't a TTY under systemd. Gunicorn's own
# [INFO] lines are unaffected -- those go through logging.StreamHandler,
# which flushes on every call regardless of this setting.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/localadmin/monitor-data-gov-gr/venv/bin/gunicorn -w 4 --threads 32 --graceful-timeout 10 --worker-class gthread -b 127.0.0.1:5000 app:app

Restart=always

[Install]
WantedBy=multi-user.target
